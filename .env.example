# Copie este arquivo para .env.local na pasta do site, só na sua máquina.
# Na Vercel: Project → Settings → Environment Variables. Cole o mesmo nome e o valor.
# Não envie o .env.local para o GitHub. Este exemplo pode ir, porque está vazio.
#
# O webhook do Discord NÃO vem pronto. Crie um canal, abra
# Configurações do canal → Integrações → Webhooks → Novo webhook → Copiar URL.
# Cole essa URL em DISCORD_WEBHOOK_URL (site) e, se quiser o aviso da compra
# feita dentro do jogo, também em setr cordova_shop_discord no server.cfg.

# --- Banco (site, Vercel) ---
# MongoDB Atlas → Connect → Drivers. A URI começa com mongodb+srv://
MONGODB_URI=
# Nome do banco dentro do Atlas. Pode deixar cordova.
MONGODB_DB=cordova

# --- Login (site, Vercel) ---
# Segredo da sessão. Gere com: openssl rand -hex 32
# Qualquer texto longo serve. Não compartilhe.
AUTH_SECRET=

# --- E-mail de confirmação e senha (site, Vercel) ---
# resend.com → API Keys. Sem isso o cadastro existe, mas o e-mail não sai.
RESEND_API_KEY=
# Remetente verificado no Resend. Troque seudominio.com pelo domínio da Vercel ou do Resend.
EMAIL_FROM="Cordova RP <loja@seudominio.com>"

# --- Login com Discord (site, Vercel) ---
# https://discord.com/developers/applications → New Application
# OAuth2 → Client ID e Client Secret.
# Em OAuth2 → Redirects, adicione:
# https://SEU-DOMINIO.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Pagamento (site, Vercel) ---
# Mercado Pago → Suas integrações → Credenciais de produção.
# O token começa com APP_USR-
MERCADOPAGO_ACCESS_TOKEN=
# URL copiada do webhook do Discord. Avisa "Fulano comprou VIP Wipe" depois do pagamento do site.
DISCORD_WEBHOOK_URL=

# --- Entrega no jogo (site, Vercel) ---
# O site chama este endereço do FiveM quando o Mercado Pago confirma.
# A porta 30120 precisa estar acessível na internet.
GAME_DELIVER_URL=http://45.146.81.194:30120/cordova_vipshop/site-delivery
# Texto longo inventado por você. O MESMO valor vai no server.cfg, em cordova_site_secret.
GAME_DELIVER_SECRET=

# --- Endereço público do site (site, Vercel) ---
# Sem barra no final. O Mercado Pago avisa https://SEU-DOMINIO.vercel.app/api/mercadopago
NEXT_PUBLIC_SITE_URL=

# --- Estas três NÃO entram na Vercel. Ficam no server.cfg da cidade. ---
# setr cordova_mp_token "APP_USR-..."     mesmo token do Mercado Pago, para a loja de dentro do jogo
# setr cordova_mp_notify ""               deixe vazio: quem recebe o aviso do Mercado Pago é o site
# setr cordova_shop_discord "https://discord.com/api/webhooks/..."   aviso da compra feita no jogo
# setr cordova_site_secret "o mesmo texto de GAME_DELIVER_SECRET"
